<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Set here as well as in the repository's props: the acceptance harness builds a copy of
         this sample, outside the repository, where those props do not reach. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Row 12: consumed as an analyser, so it produces neither a metadata reference nor a
         copy, and Reach must not expect it on disk. -->
    <ProjectReference Include="../Basics.Generator/Basics.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
