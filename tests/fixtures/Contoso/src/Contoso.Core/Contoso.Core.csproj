<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted on purpose: discovery resolves two assembly instances, and every
         invocation for this project's tests has to pin -f. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- In the closure, and deliberately not in the expected assembly set: this produces
         neither a metadata reference nor a copy. -->
    <ProjectReference Include="../Contoso.Generator/Contoso.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
