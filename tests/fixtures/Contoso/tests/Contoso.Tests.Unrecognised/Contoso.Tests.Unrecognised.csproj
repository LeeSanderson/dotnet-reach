<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- A test project by every project-level signal, on a framework Reach's recognition table
         does not cover — so it is in scope, cannot be enumerated, and falls back to
         whole-project selection. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Contoso.Core/Contoso.Core.csproj" />
  </ItemGroup>

</Project>
