# Text files are stored and checked out with CRLF on every platform (ADR-0017), so git and
# `dotnet format --verify-no-changes` agree on both CI matrix legs. Must match .editorconfig.
* text=auto eol=crlf

# Shell scripts stay LF: bash cannot run a script with CRLF endings.
*.sh text eol=lf
.husky/** text eol=lf

*.png binary
*.dll binary
*.exe binary
*.snk binary
