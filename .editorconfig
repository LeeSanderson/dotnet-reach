# Deliberately small. `dotnet format --verify-no-changes` is the gate, and every rule added
# here is a rule the gate then enforces, so only settings the codebase already keeps appear.
# end_of_line is left unset on purpose: .gitattributes normalises it per platform.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
