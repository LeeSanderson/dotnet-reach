<Project>

  <!--
    No TargetFramework here: a non-empty TargetFramework turns off a project's own
    TargetFrameworks, which would stop the Contoso fixture multi-targeting in place. Each
    project declares its own (ADR-0013 for Reach's).
  -->
  <PropertyGroup>
    <LangVersion>default</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The coding standard (analyzers, .editorconfig and build defaults) for every project. Pinned
    exactly: an upgrade is a deliberate commit that fixes any new diagnostics in the same commit.
    It only sets properties still empty, so the values above keep winning.
  -->
  <ItemGroup>
    <PackageReference Include="Opinionated.DotNet.CodingStandards" Version="[0.0.22]" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Hand-edited. A published package cannot be deleted, only unlisted, so the version
    bump and the tag push are two deliberate human acts. See spec section 16.4.
  -->
  <PropertyGroup>
    <Version>0.1.0-alpha.1</Version>
  </PropertyGroup>

  <!--
    core.hooksPath is local git config and is not cloned, so a fresh clone installs the
    pre-commit hook on its first restore. Scoped to one project so it runs once per restore;
    CI sets HUSKY=0 because the gate runs `dotnet format` itself.
  -->
  <Target Name="HuskyInstall" BeforeTargets="Restore;CollectPackageReferences"
          Condition="'$(HUSKY)' != '0' AND '$(MSBuildProjectName)' == 'Reach.Cli'">
    <Exec Command="dotnet tool restore" StandardOutputImportance="Low" StandardErrorImportance="High" />
    <Exec Command="dotnet husky install" StandardOutputImportance="Low" StandardErrorImportance="High"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>

</Project>
